@@ -0,0 +1,87 @@
+from sglang.srt.tracing.hook import register
+
+
+def register_kernels_for_profiling() -> None:
+	"""Register kernel launchers for automatic profiling.
+
+	These entries correspond to kernel calls that were previously wrapped with
+	`torch.profiler.record_function` (e.g., in a patch). We now centralize them
+	here and let the tracing hook apply consistent labels.
+
+	SGLang >= 0.5.6 moved its Triton kernels into the ``sglang.kernels.ops``
+	package. Kernels that are plain Python launchers there are registered on the
+	*consumer* module, because call sites bind them with ``from ... import x``
+	and the hook rebinds a module attribute. Kernels that are raw
+	``triton.JITFunction`` objects cannot be wrapped directly (that would break
+	the ``kernel[grid](...)`` subscript), so sglang is patched to expose a
+	``launch_*`` Python wrapper which is registered instead.
+
+	Registration is best-effort: ``apply_auto_profile`` silently skips entries
+	whose module or attribute is absent, so targets that only exist on some
+	backends are safe to list.
+	"""
+
+	# FlashInfer KV index building for the DeepSeek/GLM one-shot MHA path.
+	# ``create_flashinfer_kv_indices_triton`` is a JITFunction, so sglang is
+	# patched to provide this launcher.
+	register(
+		"sglang.srt.model_executor.forward_batch_deepseek_mha_mixin",
+		"launch_fetch_mha_one_shot_kv_indices",
+		base_name="fwd.fetch_mha_one_shot_kv_indices",
+	)
+
+	# Mem cache: write_req_to_token_pool_triton is a JITFunction; sglang is
+	# patched to provide this launcher.
+	register(
+		"sglang.srt.mem_cache.allocation",
+		"launch_write_req_to_token_pool_triton",
+		base_name="mem_cache.write_req_to_token_pool_triton",
+	)
+
+	# Forward batch info: compute_position_triton
+	register(
+		"sglang.srt.model_executor.forward_batch_info",
+		"compute_position_triton",
+		base_name="fwd.compute_position_triton",
+	)
+
+	# MLA KV buffer setup kernel
+	register(
+		"sglang.srt.mem_cache.memory_pool",
+		"set_mla_kv_buffer_triton",
+		base_name="mem_cache.set_mla_kv_buffer_triton",
+	)
+
+	# MLA KV buffer: get_mla_kv_buffer_triton
+	register(
+		"sglang.srt.mem_cache.memory_pool",
+		"get_mla_kv_buffer_triton",
+		base_name="mem_cache.get_mla_kv_buffer_triton",
+	)
+
+	# DP attention memcpy kernel
+	register(
+		"sglang.srt.layers.dp_attention",
+		"memcpy_triton",
+		base_name="dp.memcpy_triton",
+	)
+
+	# FlashInfer MLA prefill/decode. GLM/DeepSeek DSA models normally select an
+	# NSA backend instead, in which case these registrations are no-ops.
+	register(
+		"sglang.srt.layers.attention.flashinfer_mla_backend",
+		"FlashInferMLAAttnBackend.forward_decode",
+		base_name="mla.decode",
+	)
+	register(
+		"sglang.srt.layers.attention.flashinfer_mla_backend",
+		"FlashInferMLAAttnBackend.forward_extend",
+		base_name="mla.prefill",
+	)
+
+	# DeepSeekV2/GLM: concat+cast MHA K launcher
+	register(
+		"sglang.srt.models.deepseek_common.attention_forward_methods.forward_mha",
+		"concat_and_cast_mha_k_triton",
+		base_name="attn.concat_and_cast_mha_k_triton",
+	)
